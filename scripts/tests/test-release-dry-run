expect "a: a delete elsewhere fails" rejects zap_is_settings_only "$delete_elsewhere"
style_dir="$dir/style/Casks"
mkdir -p "$style_dir"
cp "$cask" "$style_dir/muninn.rb"
style_status=0
style_output="$(cd "$style_dir" && brew style "$style_dir/muninn.rb" 2>&1)" || style_status=$?
