#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: $0 [--team <ID>] <Muninn.app> [<version>]" >&2
  exit 2
}

team=""
if [[ "${1:-}" == "--team" ]]; then
  [[ $# -ge 2 && -n "$2" ]] || usage
  team="$2"
  shift 2
fi
[[ $# -ge 1 && $# -le 2 ]] || usage

app="$1"
version="${2:-}"
bundle_id=com.michaelrigart.muninn
plist="$app/Contents/Info.plist"

[[ -d "$app" ]] || { echo "not an app bundle: $app" >&2; exit 1; }

failed=0
fail() {
  echo "FAIL: $1" >&2
  failed=1
}

plist_value() {
  /usr/libexec/PlistBuddy -c "Print :$1" "$plist" 2>/dev/null || true
}

if ! codesign --verify --strict "$app" 2>/dev/null; then
  fail "signature does not verify"
fi

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

entitlements_status=0
codesign -d --entitlements - --xml "$app" >"$work/entitlements.xml" 2>"$work/entitlements.err" || entitlements_status=$?
entitlements_xml="$(<"$work/entitlements.xml")"
if [[ "$entitlements_status" -ne 0 ]] || grep -qvE '^Executable=' "$work/entitlements.err"; then
  fail "could not read entitlements"
else
  entitlements='{}'
  if [[ -n "$entitlements_xml" ]] && ! entitlements="$(plutil -convert json -o - - <<<"$entitlements_xml" 2>/dev/null)"; then
    fail "could not read entitlements"
  elif [[ "$entitlements" != '{"com.apple.security.device.audio-input":true}' ]]; then
    fail "entitlements are not exactly com.apple.security.device.audio-input: $entitlements"
  fi
fi

if [[ "$(plist_value LSUIElement)" == "true" ]]; then
  fail "LSUIElement is set; Muninn is a regular app"
fi

actual_id="$(plist_value CFBundleIdentifier)"
if [[ "$actual_id" != "$bundle_id" ]]; then
  fail "bundle identifier is '$actual_id', expected '$bundle_id'"
fi

for key in NSMicrophoneUsageDescription NSAudioCaptureUsageDescription; do
  if [[ -z "$(plist_value "$key")" ]]; then
    fail "$key is missing"
  fi
done

spike_status=0
spike="$(find "$app" -name muninn-spike 2>/dev/null)" || spike_status=$?
if [[ "$spike_status" -ne 0 ]]; then
  fail "could not search bundle: $app"
elif [[ -n "$spike" ]]; then
  fail "bundle contains muninn-spike"
fi

if [[ -n "$version" ]]; then
  short="$(plist_value CFBundleShortVersionString)"
  build="$(plist_value CFBundleVersion)"
  if [[ "$short" != "$version" ]]; then
    fail "CFBundleShortVersionString is '$short', expected '$version'"
  fi
  if [[ "$build" != "${version//-/}" ]]; then
    fail "CFBundleVersion is '$build', expected '${version//-/}'"
  fi
fi

if [[ -n "$team" ]]; then
  actual_team="$(codesign -dvv "$app" 2>&1 | sed -n 's/^TeamIdentifier=//p' || true)"
  if [[ "$actual_team" != "$team" ]]; then
    fail "TeamIdentifier is '${actual_team:-none}', expected '$team'"
  fi
fi

exit "$failed"
